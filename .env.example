# Copy to .env and choose ONE DATABASE_URL option below.
# Data flow: frontend -> backend API -> Postgres (Supabase or local container).
# The frontend never connects to the database directly.

# --- Option A: Supabase (recommended for shared / production-like dev) ---
# Use the Session pooler URI from Supabase: Project Settings -> Database -> Connection string.
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Start stack without the local Postgres container:
#   docker compose up --build

# --- Option B: Local Postgres container (Docker Compose profile local-db) ---
# Host must be `db` (Docker service name), not localhost, when the backend runs in Docker.
DATABASE_URL=postgresql+psycopg://syllabus:syllabus@db:5432/syllabus_planner
#
# Start stack with the bundled Postgres container:
#   docker compose --profile local-db up --build

# --- Option C: Backend on host, Postgres container exposed on localhost ---
# DATABASE_URL=postgresql+psycopg://syllabus:syllabus@localhost:5432/syllabus_planner
#
# Start only the database container:
#   docker compose --profile local-db up db

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
